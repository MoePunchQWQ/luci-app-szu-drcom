#!/bin/sh
# szu-drcom - Shenzhen University Dr.COM ePortal client for OpenWrt / ImmortalWrt
#
# Subcommands:
#   status    query portal online status (prints "online" / "offline" / "error")
#   login     send an ePortal login request
#   logout    send an ePortal logout request
#   daemon    run the keep-alive loop (used by procd)
#   probe     best-effort discovery of portal / AC parameters
#
# Configuration is read from UCI: /etc/config/drcom_szu (package drcom_szu, section main)

set -u

# Portal responses embed GBK encoded Chinese, which is not valid UTF-8. Under a
# UTF-8 locale sed/grep treat those bytes as non-characters and ".", "[^"]"
# stop matching as expected. Working bytewise keeps every parser deterministic.
export LC_ALL=C

UCI_PACKAGE="drcom_szu"
UCI_SECTION="main"
STATE_FILE="/tmp/szu-drcom.state"
LOG_FILE="/tmp/szu-drcom.log"
LOG_TAG="szu-drcom"
LOG_KEEP_LINES=400
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# Global scratch values filled by the request helpers.
LAST_MSG=""
LAST_IP=""

# ---------------------------------------------------------------------------
# logging
# ---------------------------------------------------------------------------

log_file() {
	printf '%s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$LOG_TAG" "$*" >>"$LOG_FILE" 2>/dev/null
}

log() {
	log_file "$*"
	logger -t "$LOG_TAG" "$*" 2>/dev/null
}

rotate_log() {
	local lines
	lines="$(wc -l <"$LOG_FILE" 2>/dev/null || echo 0)"
	lines="${lines%% *}"
	[ -n "$lines" ] || lines=0
	if [ "$lines" -gt "$((LOG_KEEP_LINES * 2))" ] 2>/dev/null; then
		tail -n "$LOG_KEEP_LINES" "$LOG_FILE" >"${LOG_FILE}.tmp" 2>/dev/null &&
			mv "${LOG_FILE}.tmp" "$LOG_FILE" 2>/dev/null
		chmod 600 "$LOG_FILE" 2>/dev/null
	fi
}

# ---------------------------------------------------------------------------
# UCI helpers
# ---------------------------------------------------------------------------

uci_get() {
	local value
	value="$(uci -q get "${UCI_PACKAGE}.${UCI_SECTION}.$1" 2>/dev/null)"
	if [ -z "$value" ]; then
		printf '%s' "${2:-}"
		return 0
	fi
	printf '%s' "$value"
}

load_config() {
	ENABLED="$(uci_get enabled 0)"
	USERNAME="$(uci_get username '')"
	PASSWORD="$(uci_get password '')"
	PORTAL_HOST="$(uci_get portal_host '172.30.255.42')"
	PORTAL_PORT="$(uci_get portal_port '801')"
	AC_IP="$(uci_get ac_ip '172.30.255.41')"
	AC_NAME="$(uci_get ac_name '')"
	LOGIN_METHOD="$(uci_get login_method '1')"
	USER_IP="$(uci_get wlan_user_ip '')"
	USER_MAC="$(uci_get wlan_user_mac '')"
	IFNAME="$(uci_get ifname '')"
	STATUS_PATH="$(uci_get status_path '/drcom/chkstatus')"
	LOGIN_PATH="$(uci_get login_path '/eportal/portal/login')"
	LOGOUT_PATH="$(uci_get logout_path '/eportal/portal/logout')"
	INTERVAL="$(uci_get interval '60')"
	TIMEOUT="$(uci_get timeout '8')"
	STARTUP_DELAY="$(uci_get startup_delay '5')"
	AUTO_LOGIN="$(uci_get auto_login '1')"

	case "$INTERVAL" in
	'' | *[!0-9]*) INTERVAL=60 ;;
	esac
	[ "$INTERVAL" -ge 10 ] 2>/dev/null || INTERVAL=10
	[ "$INTERVAL" -le 3600 ] 2>/dev/null || INTERVAL=3600

	case "$TIMEOUT" in
	'' | *[!0-9]*) TIMEOUT=8 ;;
	esac
	[ "$TIMEOUT" -ge 3 ] 2>/dev/null || TIMEOUT=3
	[ "$TIMEOUT" -le 30 ] 2>/dev/null || TIMEOUT=30
}

# ---------------------------------------------------------------------------
# encoding / transport
# ---------------------------------------------------------------------------

hexstream() {
	if command -v hexdump >/dev/null 2>&1; then
		printf '%s' "$1" | hexdump -v -e '1/1 "%02x"' 2>/dev/null
	elif command -v od >/dev/null 2>&1; then
		printf '%s' "$1" | od -An -tx1 -v 2>/dev/null | tr -d ' \n'
	else
		return 127
	fi
}

# Percent-encode a string. Unreserved characters A-Z a-z 0-9 . _ - ~ are kept
# as-is, everything else becomes %XX on a byte basis (so UTF-8 is preserved).
urlencode() {
	local input hex out ch
	input="$(hexstream "$1")" || {
		log "urlencode failed: no hexdump or od available"
		printf '%s' "$1"
		return 127
	}
	out=""
	while [ -n "$input" ]; do
		hex="${input%${input#??}}"
		input="${input#??}"
		ch="$(printf "\\x$hex" 2>/dev/null)"
		case "$ch" in
		[A-Za-z0-9._~-]) out="$out$ch" ;;
		*) out="$out%$(printf '%s' "$hex" | tr 'a-f' 'A-F')" ;;
		esac
	done
	printf '%s' "$out"
}

http_get() {
	local url="$1"
	if command -v curl >/dev/null 2>&1; then
		curl -fsS --max-time "$TIMEOUT" -A "$USER_AGENT" \
			-H "Referer: http://${PORTAL_HOST}/" "$url" 2>/dev/null
	elif command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -O - --timeout="$TIMEOUT" "$url" 2>/dev/null
	elif command -v wget >/dev/null 2>&1; then
		wget -q -T "$TIMEOUT" -O - "$url" 2>/dev/null
	else
		log "no http client available (curl / uclient-fetch / wget)"
		return 127
	fi
}

sanitize() {
	printf '%s' "$1" | tr -d '\r\n' | tr -d '"' | cut -c 1-200
}

# Extract the "msg" member from a (possibly JSONP wrapped) portal response.
extract_msg() {
	printf '%s' "$1" | sed -n 's/.*"msg"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1
}

# Extract an IPv4 address from the portal payload. The value pattern is
# restricted to digits and dots so stray bytes (GBK text) can never leak in.
extract_ip() {
	printf '%s' "$1" |
		sed -n 's/.*"\(wlan_user_ip\|user_ip\|v46ip\|v4ip\|lip\|ss5\)"[[:space:]]*:[[:space:]]*"\([0-9.]*\)".*/\2/p' |
		grep -E '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$' |
		head -n 1
}

# ---------------------------------------------------------------------------
# host information
# ---------------------------------------------------------------------------

detect_ip() {
	local addr=""
	if [ -n "${USER_IP:-}" ]; then
		printf '%s' "$USER_IP"
		return 0
	fi
	addr="$(ip -4 route get "${PORTAL_HOST}" 2>/dev/null |
		sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n 1)"
	if [ -z "$addr" ]; then
		addr="$(ip -4 route show default 2>/dev/null |
			sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n 1)"
	fi
	printf '%s' "$addr"
}

normalize_mac() {
	# Keep hex digits only, then upper case. Written as a complement so no
	# accidental ":-." range (reverse collating order) can appear.
	printf '%s' "$1" | tr -cd '0-9A-Fa-f' | tr 'a-f' 'A-F'
}

detect_iface() {
	local dev=""
	if [ -n "${IFNAME:-}" ]; then
		printf '%s' "$IFNAME"
		return 0
	fi
	dev="$(ip -4 route get "${PORTAL_HOST}" 2>/dev/null |
		sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1)"
	if [ -z "$dev" ]; then
		dev="$(uci -q get network.wan.device 2>/dev/null)"
	fi
	if [ -z "$dev" ]; then
		dev="$(uci -q get network.wan.ifname 2>/dev/null | awk '{print $1}')"
	fi
	printf '%s' "$dev"
}

detect_mac() {
	local mac dev
	if [ -n "${USER_MAC:-}" ]; then
		normalize_mac "$USER_MAC"
		return 0
	fi
	dev="$(detect_iface)"
	if [ -n "$dev" ] && [ -r "/sys/class/net/$dev/address" ]; then
		mac="$(cat "/sys/class/net/$dev/address" 2>/dev/null)"
		if [ -n "$mac" ]; then
			normalize_mac "$mac"
			return 0
		fi
	fi
	printf '%s' "000000000000"
}

# ---------------------------------------------------------------------------
# state file
# ---------------------------------------------------------------------------

write_state() {
	local status="$1"
	local message="${2:-}"
	local ip="${3:-}"
	local account="${4:-$USERNAME}"
	local login_count
	local last_login

	login_count="$(sed -n 's/^login_count=//p' "$STATE_FILE" 2>/dev/null | head -n 1)"
	last_login="$(sed -n 's/^last_login=//p' "$STATE_FILE" 2>/dev/null | head -n 1)"
	case "$login_count" in
	'' | *[!0-9]*) login_count=0 ;;
	esac

	if [ "$status" = "online" ] && [ "$1" != "$(sed -n 's/^status=//p' "$STATE_FILE" 2>/dev/null | head -n 1)" ]; then
		last_login="$(date '+%Y-%m-%d %H:%M:%S')"
		login_count=$((login_count + 1))
	fi

	message="$(sanitize "$message")"

	{
		echo "status=$status"
		echo "message=$message"
		echo "ip=$ip"
		echo "account=$account"
		echo "updated=$(date '+%Y-%m-%d %H:%M:%S')"
		echo "last_login=$last_login"
		echo "login_count=$login_count"
	} >"$STATE_FILE" 2>/dev/null
	chmod 644 "$STATE_FILE" 2>/dev/null
}

# ---------------------------------------------------------------------------
# portal calls
# ---------------------------------------------------------------------------

# Returns 0 when the portal reports this client as already authenticated.
portal_status() {
	local url resp

	url="http://${PORTAL_HOST}${STATUS_PATH}"
	url="${url}?callback=drstatus&jsVersion=4.X&lang=zh&v=$(date +%s 2>/dev/null || echo 1000)"

	resp="$(http_get "$url")" || resp=""

	if [ -z "$resp" ]; then
		LAST_MSG="无法连接认证服务器（无响应）"
		LAST_IP=""
		return 2
	fi

	if printf '%s' "$resp" | grep -Eq '"result"[[:space:]]*:[[:space:]]*(1|"1"|"ok")'; then
		LAST_MSG="$(extract_msg "$resp")"
		[ -n "$LAST_MSG" ] || LAST_MSG="已在线"
		LAST_IP="$(extract_ip "$resp")"
		[ -n "$LAST_IP" ] || LAST_IP="$(detect_ip)"
		return 0
	fi

	LAST_MSG="$(extract_msg "$resp")"
	[ -n "$LAST_MSG" ] || LAST_MSG="未在线"
	LAST_IP=""
	return 1
}

portal_login() {
	local ip mac url resp

	if [ -z "${USERNAME:-}" ] || [ -z "${PASSWORD:-}" ]; then
		LAST_MSG="未配置校园网账号或密码"
		write_state "error" "$LAST_MSG" "" ""
		log "login aborted: missing credentials"
		return 2
	fi

	ip="$(detect_ip)"
	if [ -z "$ip" ]; then
		LAST_MSG="无法获取本机 IP，请手动填写 wlan_user_ip"
		write_state "error" "$LAST_MSG" "" "$USERNAME"
		log "login aborted: cannot detect wlan user ip"
		return 3
	fi

	mac="$(detect_mac)"
	[ -n "$mac" ] || mac="000000000000"

	url="http://${PORTAL_HOST}:${PORTAL_PORT}${LOGIN_PATH}"
	url="${url}?callback=drlogin"
	url="${url}&login_method=$(urlencode "${LOGIN_METHOD}")"
	url="${url}&user_account=$(urlencode "${USERNAME}")"
	url="${url}&user_password=$(urlencode "${PASSWORD}")"
	url="${url}&wlan_user_ip=$(urlencode "${ip}")"
	url="${url}&wlan_user_ipv6="
	url="${url}&wlan_user_mac=$(urlencode "${mac}")"
	url="${url}&wlan_ac_ip=$(urlencode "${AC_IP}")"
	url="${url}&wlan_ac_name=$(urlencode "${AC_NAME}")"
	url="${url}&jsVersion=4.X"
	url="${url}&terminal_type=2"
	url="${url}&lang=zh-cn"
	url="${url}&v=$(date +%s 2>/dev/null || echo 1000)"

	resp="$(http_get "$url")" || resp=""

	if [ -z "$resp" ]; then
		LAST_MSG="登录请求无响应（网络不通或服务器不可达）"
		write_state "error" "$LAST_MSG" "$ip" "$USERNAME"
		log "login failed: empty response ip=$ip mac=$mac ac_ip=$AC_IP"
		return 1
	fi

	if printf '%s' "$resp" | grep -Eq '"result"[[:space:]]*:[[:space:]]*(1|"1"|"ok")'; then
		LAST_MSG="$(extract_msg "$resp")"
		[ -n "$LAST_MSG" ] || LAST_MSG="登录成功"
		write_state "online" "$LAST_MSG" "$ip" "$USERNAME"
		log "login ok: ip=$ip mac=$mac ac_ip=$AC_IP"
		rotate_log
		return 0
	fi

	LAST_MSG="$(extract_msg "$resp")"
	[ -n "$LAST_MSG" ] || LAST_MSG="$(sanitize "$resp")"
	[ -n "$LAST_MSG" ] || LAST_MSG="登录失败（未知原因）"
	write_state "offline" "$LAST_MSG" "$ip" "$USERNAME"
	log "login failed: ip=$ip msg=$LAST_MSG"
	rotate_log
	return 1
}

portal_logout() {
	local ip mac url resp

	ip="$(detect_ip)"
	[ -n "$ip" ] || ip="${LAST_IP:-}"
	mac="$(detect_mac)"
	[ -n "$mac" ] || mac="000000000000"

	url="http://${PORTAL_HOST}:${PORTAL_PORT}${LOGOUT_PATH}"
	url="${url}?callback=drlogout"
	url="${url}&user_account=$(urlencode "${USERNAME}")"
	url="${url}&wlan_user_ip=$(urlencode "${ip}")"
	url="${url}&wlan_user_ipv6="
	url="${url}&wlan_user_mac=$(urlencode "${mac}")"
	url="${url}&wlan_ac_ip=$(urlencode "${AC_IP}")"
	url="${url}&wlan_ac_name=$(urlencode "${AC_NAME}")"
	url="${url}&jsVersion=4.X"
	url="${url}&lang=zh-cn"
	url="${url}&v=$(date +%s 2>/dev/null || echo 1000)"

	resp="$(http_get "$url")" || resp=""

	if printf '%s' "$resp" | grep -Eq '"result"[[:space:]]*:[[:space:]]*(1|"1"|"ok")'; then
		LAST_MSG="$(extract_msg "$resp")"
		[ -n "$LAST_MSG" ] || LAST_MSG="已下线"
		write_state "offline" "$LAST_MSG" "$ip" "$USERNAME"
		log "logout ok: ip=$ip"
		return 0
	fi

	LAST_MSG="$(extract_msg "$resp")"
	[ -n "$LAST_MSG" ] || LAST_MSG="$(sanitize "$resp")"
	[ -n "$LAST_MSG" ] || LAST_MSG="下线请求未返回结果"
	write_state "offline" "$LAST_MSG" "$ip" "$USERNAME"
	log "logout failed: ip=$ip msg=$LAST_MSG"
	return 1
}

# ---------------------------------------------------------------------------
# best-effort parameter discovery
# ---------------------------------------------------------------------------

# Best-effort discovery. The chkstatus payload already carries the client IP,
# the AC name and the online MAC, so it is a far better source than scraping
# the HTML portal page.
probe_params() {
	local url resp ip ac mac
	url="http://${PORTAL_HOST}${STATUS_PATH}"
	url="${url}?callback=drstatus&jsVersion=4.X&lang=zh&v=$(date +%s 2>/dev/null || echo 1000)"
	resp="$(http_get "$url")" || resp=""

	ip="$(extract_ip "$resp")"
	ac="$(printf '%s' "$resp" |
		sed -n 's/.*"AC"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
	mac="$(printf '%s' "$resp" |
		sed -n 's/.*"\(olmac\|ss1\)"[[:space:]]*:[[:space:]]*"\([0-9A-Fa-f]*\)".*/\2/p' | head -n 1)"

	echo "portal_host=${PORTAL_HOST}"
	echo "portal_port=${PORTAL_PORT}"
	echo "wlan_user_ip=${ip}"
	echo "wlan_ac_ip=${AC_IP}"
	echo "ac_id_hint=${ac}"
	echo "wlan_user_mac=$(normalize_mac "$mac")"
	echo "detected_ip=$(detect_ip)"
	echo "detected_mac=$(detect_mac)"
	echo "detected_iface=$(detect_iface)"
	echo "online=$(printf '%s' "$resp" | grep -Eq '"result"[[:space:]]*:[[:space:]]*(1|"1"|"ok")' && echo 1 || echo 0)"
}

# ---------------------------------------------------------------------------
# daemon
# ---------------------------------------------------------------------------

SLEEP_PID=""

term_handler() {
	log "daemon stopping"
	[ -n "$SLEEP_PID" ] && kill "$SLEEP_PID" 2>/dev/null
	exit 0
}

run_daemon() {
	local last="unknown"

	load_config
	: >"$LOG_FILE" 2>/dev/null
	chmod 600 "$LOG_FILE" 2>/dev/null

	if [ "$STARTUP_DELAY" -gt 0 ] 2>/dev/null; then
		sleep "$STARTUP_DELAY" 2>/dev/null
	fi

	trap term_handler TERM INT

	log "daemon started (interval=${INTERVAL}s timeout=${TIMEOUT}s auto_login=${AUTO_LOGIN} portal=${PORTAL_HOST})"

	while true; do
		load_config

		if portal_status; then
			if [ "$last" != "online" ]; then
				log "online (ip=${LAST_IP})"
			fi
			write_state "online" "$LAST_MSG" "$LAST_IP" "$USERNAME"
			last="online"
		else
			if [ "$AUTO_LOGIN" = "1" ]; then
				log "offline, trying to login (msg=${LAST_MSG})"
				if portal_login; then
					last="online"
				else
					last="offline"
				fi
			else
				if [ "$last" != "offline" ]; then
					log "offline, auto login disabled"
				fi
				write_state "offline" "$LAST_MSG" "" "$USERNAME"
				last="offline"
			fi
		fi

		rotate_log

		sleep "$INTERVAL" &
		SLEEP_PID=$!
		wait "$SLEEP_PID" 2>/dev/null
		SLEEP_PID=""
	done
}

# ---------------------------------------------------------------------------
# entry point
# ---------------------------------------------------------------------------

usage() {
	cat <<EOF
Usage: szu-drcom <command>

Commands:
  status    query portal online status
  login     send an ePortal login request
  logout    send an ePortal logout request
  daemon    run the keep-alive loop (used by procd)
  probe     best-effort discovery of portal / AC parameters
EOF
}

load_config

case "${1:-status}" in
status)
	if portal_status; then
		write_state "online" "$LAST_MSG" "$LAST_IP" "$USERNAME"
		echo "online"
		exit 0
	fi
	write_state "offline" "$LAST_MSG" "$LAST_IP" "$USERNAME"
	echo "offline"
	exit 1
	;;
login)
	portal_login
	rc=$?
	echo "$LAST_MSG"
	exit $rc
	;;
logout)
	portal_logout
	rc=$?
	echo "$LAST_MSG"
	exit $rc
	;;
daemon)
	run_daemon
	exit 0
	;;
probe)
	probe_params
	exit 0
	;;
-h | --help | help)
	usage
	exit 0
	;;
*)
	usage
	exit 64
	;;
esac
