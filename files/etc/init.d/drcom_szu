#!/bin/sh /etc/rc.common
# procd service wrapper for the SZU Dr.COM ePortal client.

USE_PROCD=1
START=95
STOP=15

UCI_PACKAGE="drcom_szu"
UCI_SECTION="main"
SERVICE_BIN="/usr/bin/szu-drcom"
LOG_FILE="/tmp/szu-drcom.log"
STATE_FILE="/tmp/szu-drcom.state"
PROG_NAME="szu-drcom"

uci_get() {
	local value
	value="$(uci -q get "${UCI_PACKAGE}.${UCI_SECTION}.$1" 2>/dev/null)"
	[ -n "$value" ] || value="${2:-}"
	printf '%s' "$value"
}

is_enabled() {
	[ "$(uci_get enabled 0)" = "1" ]
}

stop_service() {
	# procd stops the instance it spawned itself (rc.common signals it right
	# after this hook), so there is no reason to pidof/kill by name here --
	# that also took down a daemon the operator had started by hand, and a
	# SIGKILL after one second could race an in-flight status query.
	# Drop the state file so the panel reports "not running" instead of a
	# stale timestamp.
	rm -f "$STATE_FILE" 2>/dev/null
}

start_service() {
	if ! is_enabled; then
		logger -t "$PROG_NAME" "service not started: drcom_szu.main.enabled is not 1"
		return 0
	fi

	if [ ! -x "$SERVICE_BIN" ]; then
		logger -t "$PROG_NAME" "service not started: $SERVICE_BIN is missing"
		return 1
	fi

	touch "$LOG_FILE" 2>/dev/null
	chmod 600 "$LOG_FILE" 2>/dev/null

	procd_open_instance
	procd_set_param command "$SERVICE_BIN" daemon
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 15
	procd_set_param file "/etc/config/${UCI_PACKAGE}"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$UCI_PACKAGE"
}

boot() {
	# WAN readiness is handled by the daemon itself, which sleeps for the
	# configured startup_delay before the first login attempt. Sleeping here
	# as well (a hard-coded 5 s) used to add a second, unconfigurable delay.
	start
}
